# ─────────────────────────────────────────────────────────────
# ifood-migrator-py — Variáveis de ambiente
# ─────────────────────────────────────────────────────────────

PORT=3005
HOST=localhost

# Estratégia de scraping:
#   dom      → Pure UI (Camoufox lê o que está na tela + modais de produto)
#   network  → só interceptação site-api (catalog + merchant-info/graphql)
#   auto     → dom primeiro, fallback network (recomendado)
#   camoufox → alias legado para network
SCRAPER_STRATEGY=auto

# Chave de API (deixe vazio para desabilitar autenticação)
# Gere: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Domínios permitidos no CORS (separe por vírgula)
CORS_ORIGINS=*

# Máximo de jobs rodando ao mesmo tempo
# Camoufox usa ~400MB RAM por job; ajuste conforme sua VPS
MAX_CONCURRENT_JOBS=2

# Timeout total do scraping em segundos
SCRAPE_TIMEOUT_S=60

# Banco SQLite local (histórico de scrapings)
DATABASE_PATH=./data/scraper.db
