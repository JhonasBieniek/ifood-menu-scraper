# ─────────────────────────────────────────────────────────────
# ifood-migrator-py — Variáveis de ambiente
# ─────────────────────────────────────────────────────────────

PORT=3001
HOST=localhost

# Estratégia de scraping:
#   dom      → Pure UI (DOM visível + modais de produto)
#   network  → interceptação site-api (debug/homologação)
#   auto     → dom primeiro, fallback network (recomendado)
SCRAPER_STRATEGY=auto

# Chave de API (deixe vazio para desabilitar autenticação)
API_KEY=

# Domínios permitidos no CORS (separe por vírgula)
CORS_ORIGINS=*

# Máximo de jobs rodando ao mesmo tempo
MAX_CONCURRENT_JOBS=2

# Timeout total do scraping em segundos
SCRAPE_TIMEOUT_S=60

# Máximo de modais de produto abertos por job (complementos)
MAX_ITEMS_DETAIL=40

# Salva screenshot em .debug/ quando DOM falha (true recomendado em dev)
SCRAPER_DEBUG=true
